.DS_Store
# EVERY env file, however it is named, then the one that is meant to ship.
# `.env.backup` and `.env.production` were listed by hand, so a `.env.bak.<date>`
# left behind while moving machines was committable — and it carries APP_KEY and
# the database password.
.env*
!.env.example
.phpactor.json
.phpunit.result.cache
/.codex
/.cursor/
/.idea
/.nova
/.phpunit.cache
/.vscode
/.zed
/auth.json
/node_modules
/public/build
/public/fonts-manifest.dev.json
/public/hot
/public/storage
/storage/*.key
/storage/pail
/vendor
_ide_helper.php
Homestead.json
Homestead.yaml
Thumbs.db

# Any python helper in scripts/ leaves one of these. A path-specific ignore
# only covers the folder somebody thought of.
__pycache__/

# The FCM service account. This one IS a secret: it carries a PRIVATE KEY that
# can send push as this project for ever. Never committed, never pasted
# anywhere, and it lives on the private disk because nothing serves that
# directory.
/storage/app/private/fcm.json
