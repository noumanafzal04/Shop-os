VITE_API_BASE_URL=http://localhost:8000/api/v1

# Address search and the map tiles on Shop setup / Shop settings.
#
# Vite bakes these in AT BUILD TIME, and the droplet builds from its own
# untracked `.env.production` — so leaving this blank there ships a panel whose
# address search silently does nothing. That is exactly how staging went out,
# and QA reported it as "address and location functionality missing".
#
# The screen now says so rather than sitting dead, but the fix is still to set
# the key wherever the build runs: /var/www/shopos-panel/.env.production.
VITE_MAPS_PROVIDER=geoapify
VITE_GEOAPIFY_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=

# ── Order alerts (FCM web push) ──────────────────────────────────────
#
# So a shop learns about an order with the phone in a pocket, instead of only
# while the orders page is open.
#
# The WEB config, from Firebase console → Project settings → General → Your
# apps → Web app. None of it is secret: a Firebase web config is public by
# design. The SERVICE ACCOUNT on the Laravel server is the part that is not.
#
# The VAPID key is separate: Project settings → Cloud Messaging → Web Push
# certificates → Key pair.
#
# Leave these empty and the panel behaves exactly as before — the "turn on
# alerts" card does not appear at all.
#
# NOTE: notifications need HTTPS. A service worker never registers over plain
# http, and `localhost` is the only exception.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
