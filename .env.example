VITE_API_BASE_URL=http://localhost:8000/api/v1

# Address search and the map tiles on Shop setup / Shop settings.
#
# Vite bakes these in AT BUILD TIME, and the droplet builds from its own
# untracked `.env.production` — so leaving this blank there ships a panel whose
# address search silently does nothing. That is exactly how staging went out,
# and QA reported it as "address and location functionality missing".
#
# The screen now says so rather than sitting dead, but the fix is still to set
# the key wherever the build runs: /var/www/shopos-panel/.env.production.
VITE_MAPS_PROVIDER=geoapify
VITE_GEOAPIFY_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=
