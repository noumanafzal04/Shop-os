<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
        <!--
          THE FRAME BEFORE JAVASCRIPT EXISTS.

          Without this the launcher shows a WHITE sheet for the second or so
          it takes to start the runtime, and the app appears to flash before
          it opens. This app had no `windowBackground` at all, so it was doing
          exactly that — the customer app fixed it long ago and the shop app
          never got the same line.

          WHITE since 2026-11-20 ("splash ko white k acha bnao"): the animated
          splash (BootScreen) assembles the logo on white, and this frame must
          be the same ground or the app flashes teal first. Light status bar:
          the clock is drawn dark on it.
        -->
        <item name="android:windowBackground">@color/splash</item>
        <item name="android:statusBarColor">@color/splash</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

</resources>
