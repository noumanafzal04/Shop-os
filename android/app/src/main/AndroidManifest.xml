<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Location-based marketplace: GPS → nearest city + delivery pin -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!--
      A rider photographs their CNIC and driving licence to apply.

      CAMERA is declared but NOT required: `react-native-image-picker` also
      opens the gallery, and a device with no camera must still be able to
      install the app rather than be filtered out of the Play Store listing by
      a permission the shopping half never uses.
    -->
    <!--
      Android 13 and later will not show a notification until the person has
      been asked. Declared here and REQUESTED at runtime — see
      `src/services/push.ts`.

      It was missing from this app entirely, and `messaging().requestPermission()`
      returns "authorised" on Android whether or not the runtime permission
      exists. So the app believed push was on, the phone dropped every message,
      and nothing anywhere said why. The partner app had both halves; this one
      had neither.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:supportsRtl="true">

      <!--
        THE CHANNEL A PUSH ARRIVES ON.

        Android 8 and later DROP a notification whose channel it does not
        recognise — silently, with no error and nothing in logcat that names
        the cause. The server sends `default` (config/services.php →
        `FCM_CHANNEL`), so this must agree with it.

        `tools:replace` because the messaging library declares this same
        meta-data with an EMPTY value and the merger refuses two. Left to the
        library's blank the channel id would be "", which Android does not
        recognise, so every notification would be dropped in silence.
      -->
      <meta-data
        android:name="com.google.firebase.messaging.default_notification_channel_id"
        android:value="default"
        tools:replace="android:value" />

      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>

        <!--
          The app's own scheme: cartze://shop/burger-hut

          Works only where the app is already installed, and most chat apps do
          not make it tappable. It is the fallback, not the share link.
        -->
        <intent-filter>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="cartze" />
        </intent-filter>

        <!--
          The real share link: https://cartze.shop/shop/burger-hut

          It is tappable everywhere and, for anyone without the app, it opens
          the website instead of failing — which is why a share button should
          produce THIS and never the scheme above.

          NOT YET LIVE. `autoVerify` makes Android fetch

              https://cartze.shop/.well-known/assetlinks.json

          and open the app only if that file names this package and this
          signing certificate. Until the file is published, Android 12+ sends
          these links to the browser — the correct fallback, and inert rather
          than broken. Publishing it is a server change, not an app one.
        -->
        <intent-filter android:autoVerify="true">
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" android:host="cartze.shop" />
        </intent-filter>
      </activity>
    </application>
</manifest>
